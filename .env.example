# ==============================================================================
# 🚩 GANPATI MANDAL MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MANDAL CONFIGURATION (मंडळ तपशील)
# ------------------------------------------------------------------------------
# MANDAL_ID: Unique identifier for the Mandal. Used to isolate database collections.
# In Firestore, all collections (users, receipts, expenses, audit_logs) are stored under:
# /mandals/{MANDAL_ID}/users
# /mandals/{MANDAL_ID}/receipts
# /mandals/{MANDAL_ID}/expenses
# /mandals/{MANDAL_ID}/audit_logs
# Example: "ekdant-mandel-2026" or "ekdant_unchgaon" or "azad_hind_mandal"
MANDAL_ID="ekdant-mandel-2026-2026"

# MANDAL_NAME: Official name of the Mandal in Marathi/English
# Example: "श्री एकदंत मित्र मंडळ" or "श्री एकदंत मित्र मंडळ"
MANDAL_NAME="श्री एकदंत मित्र मंडळ"

# MANDAL_PREFIX: Receipt number prefix (e.g. EMM-2026-0001)
# Example: "EMM" or "EMM"
MANDAL_PREFIX="EMM"

# MANDAL_REG_NO: Mandal Government Registration / Trust Number
# Example: "26/2012"
MANDAL_REG_NO="26/2012"

# MANDAL_LOCATION: Mandal location / city / address
# Example: "सिद्धिविनायक कॉलनी, मनेरमळा, उचगाव, कोल्हापूर" or "सिद्धिविनायक कॉलनी, मनेरमळा, उचगाव, कोल्हापूर"
MANDAL_LOCATION="सिद्धिविनायक कॉलनी, मनेरमळा, उचगाव, कोल्हापूर"

# ------------------------------------------------------------------------------
# 2. MAIN ADMIN CONFIGURATION (मुख्य अध्यक्ष क्रेडेंशियल्स)
# ------------------------------------------------------------------------------
# MAIN_ADMIN_NAME: Full name of the Main Admin (Chief President)
# Example: "आनंद नाईक" or "आनंद नाईक"
MAIN_ADMIN_NAME="आनंद नाईक"

# MAIN_ADMIN_MOBILE: 10-digit registered mobile number for Main Admin login
# Example: "8149703310"
MAIN_ADMIN_MOBILE="8149703310"

# MAIN_ADMIN_PASSWORD: Secure password for Main Admin login & factory reset actions
# Example: "Atul@2462"
MAIN_ADMIN_PASSWORD="Aanand@8149"

# MAIN_ADMIN_ROLE: Role name (defaults to "admin")
MAIN_ADMIN_ROLE="admin"

# ------------------------------------------------------------------------------
